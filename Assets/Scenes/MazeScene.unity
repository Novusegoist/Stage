  letterPrefab: {fileID: 0}
  picturePrefab: {fileID: 0}
  exitButtonPrefab: {fileID: 0}
  floorMaterial: {fileID: 2100000, guid: d1f70f11b63ce27428e3b9d6815b8795, type: 2}
  wallMaterial: {fileID: 2100000, guid: 08f35d94588701a4ba18c6857c8d1f10, type: 2}
  ceilingMaterial: {fileID: 2100000, guid: 2f1e1d2320d5f6a4ba719b671c72f4c9, type: 2}
  pictureTexture: {fileID: 2800000, guid: 86cd1cf0067958a408d3c09af59f9ac2, type: 3}
  letterTitle: "\u041F\u0438\u0441\u044C\u043C\u043E"
  letterText: "\u041F\u0440\u0438\u0432\u0435\u0442, \u0434\u0440\u0443\u0433, \u0441\u043F\u0430\u0441\u0438\u0431\u043E,
    \u0447\u0442\u043E \u0440\u0435\u0448\u0438\u043B \u043F\u0440\u0438\u043D\u044F\u0442\u044C
    \u0443\u0447\u0430\u0441\u0442\u0438\u0435 \u0432 \"\u0442\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0438\"
    \u043C\u043E\u0435\u0439 \u043F\u0435\u0440\u0432\u043E\u0439 \u0438\u0433\u0440\u044B.
    \u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0437\u0434\u0435\u0441\u044C
    \u0435\u0441\u0442\u044C \u043A\u0443\u0447\u0430 \u0431\u0430\u0433\u043E\u0432
    \u0438 \u0442.\u0434, \u043D\u043E \u043D\u0430 \u0442\u043E \u043E\u043D\u0430
    \u0438 \u043F\u0435\u0440\u0432\u0430\u044F \u0438\u0433\u0440\u0430. \u041D\u0430\u0434\u0435\u044E\u0441\u044C,
    \u0432 \u0431\u0443\u0434\u0443\u0449\u0435\u043C \u0441\u0442\u0430\u0442\u044C
    \u043D\u0430\u043C\u043D\u043E\u0433\u043E \u043B\u0443\u0447\u0448\u0435, \u0438
    \u0442\u044B \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430 \u043C\u043D\u0435
    \u0432 \u044D\u0442\u043E\u043C \u043F\u043E\u043C\u043E\u0436\u0435\u0448\u044C.
    \u041E\u0441\u0442\u0430\u0432\u044C, \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430
    \u043E\u0431\u0440\u0430\u0442\u043D\u0443\u044E \u0441\u0432\u044F\u0437\u044C,
    \u043C\u043D\u0435 \u0431\u0443\u0434\u0435\u0442 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u043E
    \u043F\u043E\u0447\u0438\u0442\u0430\u0442\u044C.             \u0421 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C,
    NeoZinxy <3"
